VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Runtime E2E / deployment secrets are configured outside the repository.
# E2E_BASE_URL is supplied to the workflow as an input.
# E2E_EMAIL and E2E_PASSWORD are GitHub Actions secrets.
# OUTBOX_WORKER_TOKEN, OUTBOX_WEBHOOK_URL and OUTBOX_WEBHOOK_TOKEN are Supabase Function secrets.
# OUTBOX_WEBHOOK_TOKEN is required for outbound delivery; events fail closed when it is absent.
